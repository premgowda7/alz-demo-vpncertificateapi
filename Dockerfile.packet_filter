FROM python:3.12-slim

# NetfilterQueue is a C extension binding to libnetfilter-queue/libnfnetlink.
# libcap2-bin provides setcap, used below to grant NET_ADMIN/NET_RAW to the
# non-root runtime user.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libnetfilter-queue-dev \
        libnfnetlink-dev \
        libcap2-bin \
        pkg-config \
        curl \
    && rm -rf /var/lib/apt/lists/*

ADD requirements.txt /root/requirements.txt
RUN pip3 install --no-cache-dir --upgrade pip --trusted-host pypi.python.org -r /root/requirements.txt

# Non-root runtime user. docker-compose cap_add (NET_ADMIN/NET_RAW) only puts
# those capabilities in the container's bounding set for non-root UIDs, it
# does not raise them into the effective/permitted sets, so NFQUEUE.bind()
# would still fail with "Are you root?". File capabilities on the python
# binary raise them into the process's permitted/effective sets at exec time.
RUN groupadd --gid 1000 packetfilter \
    && useradd --uid 1000 --gid packetfilter --create-home --shell /usr/sbin/nologin packetfilter \
    && mkdir -p /data /app \
    && chown -R packetfilter:packetfilter /data /app \
    && setcap cap_net_admin,cap_net_raw+eip /usr/local/bin/python3.12
USER packetfilter

ENTRYPOINT /bin/bash

EXPOSE 8000
